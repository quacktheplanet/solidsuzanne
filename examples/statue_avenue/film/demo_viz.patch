+# ---- DEMO BUILD ONLY: breakdown attributes for the tech-demo films ---------------------------
+# runtime.cpp packs (cluster_id << 6) | depth into face_lod in this build. Each chunk mesh gets a
+# corner BYTE_COLOR "vgeo_viz": RGB = a hash colour per cluster (meshlet view), A = depth / 16 (the
+# LOD ramp in the statue avenue materials). Write byte colours through foreach_set, never the raw
+# float fast path (that corrupted the heap).
+DEMO_VIZ = True
+
+
+def _hash_u32(x):
+    x = x.astype(np.uint32)
+    x ^= x >> np.uint32(16)
+    x *= np.uint32(0x7feb352d)
+    x ^= x >> np.uint32(15)
+    x *= np.uint32(0x846ca68b)
+    x ^= x >> np.uint32(16)
+    return x
+
+
+def _demo_viz_attrs(me, data):
+    packed = data["face_lod"].astype(np.int64)
+    nt = len(packed)
+    cid = (packed >> 6).astype(np.uint32)
+    depth = (packed & 63).astype(np.float32)
+    hc = _hash_u32(cid * np.uint32(2654435761) + np.uint32(17))
+    rgba = np.empty((nt, 4), np.float32)
+    rgba[:, 0] = (hc & np.uint32(0xFF)).astype(np.float32) / 255.0
+    rgba[:, 1] = ((hc >> np.uint32(8)) & np.uint32(0xFF)).astype(np.float32) / 255.0
+    rgba[:, 2] = ((hc >> np.uint32(16)) & np.uint32(0xFF)).astype(np.float32) / 255.0
+    rgba[:, 3] = depth / 16.0
+    a = me.attributes.new("vgeo_viz", 'BYTE_COLOR', 'CORNER')
+    a.data.foreach_set("color", np.ascontiguousarray(np.repeat(rgba, 3, axis=0)).ravel())
+
+
 def fill_mesh(me, data, materials, lod_colors):
     """Replace a mesh's geometry with an extracted chunk."""
     global _fast_write
